# 2 × RTX 3090 部署（原方案）：GPU0 看图+大脑 Qwen3-VL-8B，GPU1 语音识别+语音合成
# 用法：cp scripts/models.2x3090.env scripts/models.env
VLLM_VENV=/data7/Vision-Voice-Agent/venvs/vllm
OMNI_VENV=/data7/Vision-Voice-Agent/venvs/vllm-omni

VLM_MODEL=/data7/Vision-Voice-Agent/models/Qwen3-VL-8B-Instruct
ASR_MODEL=/data7/Vision-Voice-Agent/models/Qwen3-ASR-1.7B
TTS_MODEL=/data7/Vision-Voice-Agent/models/Qwen3-TTS-12Hz-1.7B-CustomVoice

VLM_NAME=qwen3-vl-8b
ASR_NAME=qwen3-asr
TTS_NAME=qwen3-tts

VLM_GPU=0
ASR_GPU=1
TTS_GPU=1
VLM_PORT=8001
ASR_PORT=8002
TTS_PORT=8003

VLM_GPU_UTIL=0.92
VLM_MAX_LEN=16384
VLM_MAX_IMAGES=8
ASR_GPU_UTIL=0.30
# 1：TTS 带 --enforce-eager 启动（稳妥但首包慢）；0：去掉它提速，起不来再改回 1
TTS_ENFORCE_EAGER=1

export HF_HOME=/data7/Vision-Voice-Agent/.cache/huggingface
export MODELSCOPE_CACHE=/data7/Vision-Voice-Agent/.cache/modelscope

# 不用 FlashInfer 采样（它要调用系统里过旧的 CUDA 11.8 编译器）
export VLLM_USE_FLASHINFER_SAMPLER=0
unset CUDA_HOME
