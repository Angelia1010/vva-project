# 4 × RTX 3090（24G）部署：Qwen3.6-35B-A3B 两卡合跑，语音识别、语音合成各占一张卡
#   GPU 0+1  Qwen3.6-35B-A3B-FP8   智能体大脑 + 看图（张量并行）   端口 8001
#   GPU 2    Qwen3-ASR-1.7B        语音识别                         端口 8002
#   GPU 3    Qwen3-TTS-1.7B        语音合成                         端口 8003
# 用法：cp scripts/models.4x3090.env scripts/models.env
# 显卡编号按 PCI 总线顺序，与 nvidia-smi 一致（lib_models.sh 已设置 CUDA_DEVICE_ORDER=PCI_BUS_ID）

VLLM_VENV=/data7/Vision-Voice-Agent/venvs/vllm
OMNI_VENV=/data7/Vision-Voice-Agent/venvs/vllm-omni

VLM_MODEL=/data7/Vision-Voice-Agent/models/Qwen3.6-35B-A3B-FP8
ASR_MODEL=/data7/Vision-Voice-Agent/models/Qwen3-ASR-1.7B
TTS_MODEL=/data7/Vision-Voice-Agent/models/Qwen3-TTS-12Hz-1.7B-CustomVoice

VLM_NAME=qwen3.6-35b
ASR_NAME=qwen3-asr
TTS_NAME=qwen3-tts

VLM_GPU=0,1          # 两张卡合跑（自动加 --tensor-parallel-size 2）
ASR_GPU=2
TTS_GPU=3
VLM_PORT=8001
ASR_PORT=8002
TTS_PORT=8003

# ---- 大模型
VLM_GPU_UTIL=0.93
VLM_MAX_LEN=16384            # 语音问答足够；显存只剩 3G 左右给上下文
VLM_MAX_IMAGES=4
VLM_TOOL_PARSER=qwen3_coder       # Qwen3.6 官方的工具调用解析器（8B 时是 hermes）
VLM_REASONING_PARSER=qwen3        # 把思考内容和回答分开；实时对话在 config 里关闭思考
# 前缀缓存：系统提示词、技能目录每次都一样，缓存后首字更快
# 图像编码数据并行：两张卡各自编码图片，减少卡间通信
VLM_EXTRA_ARGS="--enable-prefix-caching --mm-encoder-tp-mode data --max-num-seqs 16"   # Qwen3.6 是混合架构，每个并发请求占一块状态缓存，默认 256 会启动失败
# 多 token 预测加速（MTP）。两张 3090 之间没有 NVLink 时可能反而变慢，默认不开；
# 想试的话取消下一行注释，用 scripts/check_models.py 对比前后耗时
# VLM_SPECULATIVE='{"method":"qwen3_next_mtp","num_speculative_tokens":2}'

# ---- 语音
ASR_GPU_UTIL=0.60                 # 独占一张卡，可以给多一些
TTS_ENFORCE_EAGER=0               # 独占一张卡后去掉 --enforce-eager 提速；起不来再改回 1

export HF_HOME=/data7/Vision-Voice-Agent/.cache/huggingface
export MODELSCOPE_CACHE=/data7/Vision-Voice-Agent/.cache/modelscope

# 两卡合跑卡在启动阶段（NCCL 初始化不动）时，取消下一行注释后重启
# EXTRA_ENV="NCCL_P2P_DISABLE=1"

# 不用 FlashInfer 采样（它要调用系统里过旧的 CUDA 11.8 编译器）
export VLLM_USE_FLASHINFER_SAMPLER=0
unset CUDA_HOME
